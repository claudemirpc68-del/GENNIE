# Telegram Bot Token (obtido via @BotFather)
TELEGRAM_TOKEN=seu_telegram_bot_token_aqui

# ID do usuário dono no Telegram (para controle de acesso exclusivo)
DONO_ID=seu_telegram_user_id_aqui

# Chave de API da LLM (Groq / DeepSeek)
DEEPSEEK_API_KEY=sua_api_key_aqui
DEEPSEEK_MODEL=openai/gpt-oss-120b
DEEPSEEK_URL=https://api.groq.com/openai/v1/chat/completions

# ── Servidor de API REST (Bridge Server para integrações) ───────
BRIDGE_PORT=8000
BRIDGE_HOST=0.0.0.0
BRIDGE_SECRET_KEY=gennie_bridge_secret_token_2026
